---
// Every agent reports to one village: the agents' marks around the app's icon, joined by dotted
// lines. src/motion/agents.ts plays the reports in turn (the agent says its state, the report
// travels the line to the village, the village takes it). Without motion every line is still and
// the bubbles stay hidden; the list under the graph carries the same facts.
import AgentLogo from './AgentLogo.astro';
import { reports } from '../data/site';

type Side = 'up' | 'left' | 'right';
// Where each agent stands (percent of the graph box) and which side its bubble opens on.
const layout: Partial<Record<string, { x: number; y: number; side: Side }>> = {
  codex: { x: 30, y: 16, side: 'left' },
  antigravity: { x: 70, y: 16, side: 'right' },
  claude: { x: 11, y: 70, side: 'up' },
  opencode: { x: 89, y: 70, side: 'up' },
  grok: { x: 50, y: 100, side: 'right' },
};
const hub = { x: 50, y: 42 };
const nodes = reports.flatMap((r) => (layout[r.agent] ? [{ ...r, ...layout[r.agent]! }] : []));
---
<div class="net" data-net aria-hidden="true" style={`--hx:${hub.x}%;--hy:${hub.y}%`}>
  <svg class="net__lines" viewBox="0 0 100 100" preserveAspectRatio="none">
    {nodes.map((n, i) => <line x1={n.x} y1={n.y} x2={hub.x} y2={hub.y} data-line={i} vector-effect="non-scaling-stroke" />)}
  </svg>
  {nodes.map((n, i) => (
    <span class="net__trip" data-trip={i} data-dx={hub.x - n.x} data-dy={hub.y - n.y}>
      <i style={`--x:${n.x}%;--y:${n.y}%`}></i>
    </span>
  ))}
  <div class="net__hub" data-hub>
    <span class="net__tile net__tile--hub"><img src="/img/icon-160.webp" alt="" width="160" height="160" loading="lazy" decoding="async" /></span>
    <span class="net__name">Your village</span>
  </div>
  {nodes.map((n, i) => (
    <div class="net__node" style={`--x:${n.x}%;--y:${n.y}%`} data-node={i}>
      <span class="net__tile"><AgentLogo kind={n.agent} /></span>
      <span class="net__name">{n.name}</span>
    </div>
  ))}
  {nodes.map((n, i) => (
    <div class={`net__say net__say--${n.side}`} style={`--x:${n.x}%;--y:${n.y}%`}>
      <div class="net__bubble" data-say={i}>
        <p class="net__who"><i class={`net__dot net__dot--${n.status}`}></i>{n.name} <span>· {n.label}</span></p>
        <p class="net__text">{n.text}</p>
      </div>
    </div>
  ))}
</div>
