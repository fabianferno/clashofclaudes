---
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import SessionStage from '../components/SessionStage.astro';
import DownloadButton from '../components/DownloadButton.astro';
import Builder from '../components/Builder.astro';
import TreeLine from '../components/TreeLine.astro';
import { agents, faq, privacy, site, tour, villageNotes } from '../data/site';
---
<Base description="A Mac app that runs Claude Code, Codex, Antigravity CLI and OpenCode as builders in a village: see who is working, who needs you, who shipped.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  })} />
  <section class="hero" aria-labelledby="hero-title">
    <HeroScene />
    <div class="hero__copy">
      <h1 class="title hero__title" id="hero-title" data-split="lines" data-intro>Run all your coding agents from one village.</h1>
      <p class="hero__lede">
        Claude Code, Codex, Antigravity CLI and OpenCode sessions become builders in a little
        isometric town on your Mac. See who is working, who needs you and who shipped, without
        clicking through terminal tabs.
      </p>
      <div class="hero__cta" data-reveal="up" data-intro data-delay="0.15">
        <DownloadButton requirements />
        <p class="hero__more"><a class="ulink" href="/beta/">How the beta works</a></p>
      </div>
    </div>
  </section>

  <section class="statement" aria-labelledby="why-title">
    <h2 class="statement__title" id="why-title" data-split="lines">Four agents in four repos look exactly like twelve terminal tabs.</h2>
    <div class="statement__art" aria-hidden="true" data-reveal="place">
      <div class="tabs">
        <span class="tab">~/api  claude</span>
        <span class="tab">~/web  codex</span>
        <span class="tab is-waiting">~/docs  agy</span>
        <span class="tab">~/cli  opencode</span>
      </div>
      <div class="unit"><img src="/img/bubble-needs.webp" alt="" width="120" height="120" loading="lazy" /><span class="builder" style="--sheet:url(/img/builder-apprentice-antigravity.webp)"></span></div>
    </div>
    <div class="statement__body" data-reveal="up">
      <p>One is stuck on a permission prompt. One finished ten minutes ago. One is still thinking. You find out by clicking through all of them.</p>
      <p>In the village the answer is on screen: a builder hammering away is working, a red “!” is waiting for you, a medal means it shipped. The real terminal is always one click away.</p>
    </div>
  </section>

  <SessionStage />

  <section class="roster" id="builders" aria-labelledby="builders-title">
    <TreeLine class="roster__trees" seed={3} />
    <div class="roster__inner">
      <div class="roster__head">
        <h2 class="title" id="builders-title" data-split="lines">Bring the agents you already use</h2>
        <p class="roster__lede">
          The app runs the agent CLIs you have installed and signed in to, with your own logins. It
          never installs agents or touches your API keys. The Town Hall shows which ones it found.
        </p>
      </div>
      <ul class="cards">
        {agents.map((a, i) => (
          <li class={`card card--${a.key}`} data-reveal="up" data-delay={(i * 0.06).toFixed(2)}>
            <div class="card__tile" aria-hidden="true">
              <Builder sheet={a.builder} pose="idle" class="card__builder" />
              <span class="card__rank">{a.rank}</span>
            </div>
            <h3 class="card__name">{a.name}</h3>
            <p class="card__cmd"><code>{a.command}</code></p>
            <dl class="card__facts">
              <div><dt>The village shows</dt><dd>{a.reports}</dd></div>
              <div><dt>Permission prompts</dt><dd>{a.approve}</dd></div>
            </dl>
            <p class={`card__badge ${a.verified ? 'is-verified' : 'is-pending'}`}>
              {a.verified ? `Checked against real ${a.command} runs` : `Built from the ${a.name} docs. Help us confirm it`}
            </p>
          </li>
        ))}
      </ul>
      <p class="roster__custom">
        <strong>Any other command works too.</strong> It counts as working while it prints, finished
        after it goes quiet, and stuck if it exits with an error or stays silent too long.
      </p>
    </div>
  </section>

  <section class="tour" id="app" aria-labelledby="tour-title" data-tour>
    <div class="tour__pin">
      <div class="tour__copy">
        <h2 class="title tour__title" id="tour-title" data-split="lines">The real app, up close</h2>
        <ol class="tour__stops">
          {tour.map((t, i) => (
            <li class="tour__stop" data-stop={i} data-x={t.x} data-y={t.y} data-zoom={t.zoom}>
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <figure class="tour__frame">
        <div class="tour__window">
          <div class="tour__bar" aria-hidden="true"><i></i><i></i><i></i><span>Clash of Claudes</span></div>
          <div class="tour__view">
            <div class="tour__cam" data-tour-cam>
              <picture>
                <source media="(max-width: 860px)" srcset="/img/village-1600.webp" />
                <img src="/img/village-2400.webp" srcset="/img/village-1600.webp 1600w, /img/village-2400.webp 2400w" sizes="(max-width: 860px) 100vw, 62vw"
                  width="2400" height="1500" loading="lazy" decoding="async"
                  alt="The Clash of Claudes window: four walled workspaces around Fabian's Town Hall, each with a house, agent tents and builders. One builder has a red Waiting for you plate, the top left counts 4 building, 1 needs you and 2 ready to review, usage bars for Claude, Codex and Antigravity sit top right, and a roster of eight builders runs along the bottom." />
              </picture>
              {tour.slice(0, -1).map((t, i) => (
                <span class="tour__ring" data-ring={i} style={`--x:${t.x * 100}%;--y:${t.y * 100}%`} aria-hidden="true"></span>
              ))}
            </div>
          </div>
        </div>
        <figcaption>The app running with a sample village: four workspaces, eight builders, real UI.</figcaption>
      </figure>
    </div>
  </section>

  <section class="board" aria-labelledby="board-title">
    <div class="board__copy">
      <h2 class="title board__title" id="board-title" data-split="lines">A Kanban for every workspace</h2>
      <p class="board__lede">Write tasks in To Do and start one when a builder is free. Sessions move across Active, Needs You and Finished on their own, and a permission prompt can be allowed or denied right on its card.</p>
      <ul class="board__notes">
        {villageNotes.map((n) => (
          <li data-reveal="up"><h3>{n.title}</h3><p>{n.text}</p></li>
        ))}
      </ul>
    </div>
    <figure class="board__shot" data-board>
      <picture>
        <source media="(max-width: 860px)" srcset="/img/kanban-820.webp" />
        <img src="/img/kanban-2000.webp" width="2000" height="451" loading="lazy" decoding="async"
          alt="The payments-api Kanban: two to-dos waiting for a free builder, Gus on Codex rate-limiting the webhook route in Active, Cyra on Claude Code asking to run pnpm prisma migrate deploy with Allow and Deny buttons in Needs You, and Hana's finished Stripe webhook retry in Finished." />
      </picture>
    </figure>
  </section>

  <section class="privacy" aria-labelledby="privacy-title">
    <div class="privacy__head">
      <h2 class="privacy__title" id="privacy-title" data-split="lines">Your agents’ work stays on your Mac.</h2>
      <p><a class="ulink" href="/privacy/">Everything the app does and never does</a></p>
    </div>
    <ul class="facts">
      {privacy.map((p) => (
        <li data-reveal="up"><h3>{p.title}</h3><p>{p.text}</p></li>
      ))}
    </ul>
  </section>

  <section class="faq" id="faq" aria-labelledby="faq-title">
    <div class="faq__head">
      <h2 class="title faq__title" id="faq-title" data-split="lines">Questions, answered</h2>
      <p>Still curious? <a class="ulink" href={site.maker.x} rel="me noopener">DM @{site.maker.handle} on X</a>.</p>
    </div>
    <div class="faq__list">
      {faq.map((f, i) => (
        <details class="faq__item" data-reveal="up" data-delay={(i * 0.04).toFixed(2)} open={i === 0}>
          <summary><h3>{f.q}</h3><span class="faq__mark" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="beta" id="beta" aria-labelledby="beta-title">
    <div class="beta__main">
      <h2 class="title" id="beta-title" data-split="lines">Join the beta</h2>
      <p class="beta__lede">You are getting this early. Things will break, and what you find decides what gets built next.</p>
      <ol class="steps">
        <li data-reveal="place"><span class="steps__n" aria-hidden="true">1</span><span><strong>Download</strong> the disk image.</span></li>
        <li data-reveal="place" data-delay="0.08"><span class="steps__n" aria-hidden="true">2</span><span><strong>Drag</strong> Clash of Claudes onto Applications.</span></li>
        <li data-reveal="place" data-delay="0.16"><span class="steps__n" aria-hidden="true">3</span><span><strong>Launch</strong> it. It is signed and notarized, so it opens like any other app.</span></li>
      </ol>
      <DownloadButton label="Download the beta" />
    </div>
    <aside class="panel beta__panel" aria-labelledby="feedback-title" data-reveal="up">
      <h3 id="feedback-title">Send what you find</h3>
      <p>Bugs and ideas go straight from the app. You see the whole report before it is sent.</p>
      <ul class="menu-paths">
        <li><kbd>Help</kbd><span aria-label="then">›</span><kbd>Report a Bug…</kbd></li>
        <li><kbd>Help</kbd><span aria-label="then">›</span><kbd>Request a Feature…</kbd></li>
        <li><kbd>Settings</kbd><span aria-label="then">›</span><kbd>Beta feedback</kbd></li>
      </ul>
      <h3>It keeps itself current</h3>
      <p>New beta builds install themselves, so you are always testing the latest one.</p>
      <h3>You will need</h3>
      <ul class="needs">
        <li>An Apple Silicon or Intel Mac on macOS 13 or newer.</li>
        <li>At least one agent CLI installed and signed in.</li>
      </ul>
    </aside>
  </section>
</Base>
