---
import Base from '../layouts/Base.astro';
import HeroScene from '../components/HeroScene.astro';
import DownloadButton from '../components/DownloadButton.astro';
import AgentNetwork from '../components/AgentNetwork.astro';
import AgentLogo from '../components/AgentLogo.astro';
import TreeLine from '../components/TreeLine.astro';
import Trailer from '../components/Trailer.astro';
import Reel from '../components/Reel.astro';
import { agents, faq, privacy, site } from '../data/site';
---
<Base description="A Mac app that runs Claude Code, Codex, Antigravity CLI and OpenCode as builders in a village: see who is working, who needs you, who shipped.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  })} />
  <section class="hero" aria-labelledby="hero-title">
    <HeroScene />
    <div class="hero__copy">
      <h1 class="title hero__title" id="hero-title" data-split="lines" data-intro>Run all your coding agents from one village.</h1>
      <p class="hero__lede">
        Claude Code, Codex, Antigravity CLI and OpenCode sessions become builders in a little
        isometric town on your Mac. See who is working, who needs you and who shipped, without
        clicking through terminal tabs.
      </p>
      <div class="hero__cta" data-reveal="up" data-intro data-delay="0.15">
        <DownloadButton requirements />
        <p class="hero__more"><a class="ulink" href="/beta/">How the beta works</a></p>
      </div>
    </div>
  </section>

  <Trailer />

  <Reel />

  <section class="roster" id="builders" aria-labelledby="builders-title">
    <TreeLine class="roster__trees" seed={3} />
    <div class="roster__inner">
      <div class="roster__head">
        <h2 class="title" id="builders-title" data-split="lines">Bring the agents you already use</h2>
        <p class="roster__lede">
          The app runs the agent CLIs you have installed and signed in to, with your own logins. Each
          one reports to the village as it works. It never installs agents or touches your API keys.
        </p>
      </div>
      <AgentNetwork />
      <ul class="agents">
        {agents.map((a, i) => (
          <li class="agents__item" data-reveal="up" data-delay={(i * 0.06).toFixed(2)}>
            <div class="agents__name"><AgentLogo kind={a.key} class="agents__logo" /><h3>{a.name}</h3> <code>{a.command}</code></div>
            <p><b>The village shows</b> {a.reports}</p>
            <p><b>Permission prompts</b> {a.approve}</p>
            <p class={`agents__badge ${a.verified ? 'is-verified' : 'is-pending'}`}>
              {a.verified ? `Checked against real ${a.command} runs` : `Built from the ${a.name} docs. Help us confirm it`}
            </p>
          </li>
        ))}
        <li class="agents__item" data-reveal="up" data-delay="0.24">
          <div class="agents__name"><AgentLogo kind="custom" class="agents__logo" /><h3>Any command</h3></div>
          <p><b>The village shows</b> Working while it prints, finished after it goes quiet, and stuck if it exits with an error or stays silent too long.</p>
          <p><b>Permission prompts</b> Whatever it asks, you answer in the terminal it runs in.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="privacy" aria-labelledby="privacy-title">
    <div class="privacy__head">
      <h2 class="privacy__title" id="privacy-title" data-split="lines">Your agents’ work stays on your Mac.</h2>
      <p><a class="ulink" href="/privacy/">Everything the app does and never does</a></p>
    </div>
    <ul class="facts">
      {privacy.map((p) => (
        <li data-reveal="up"><h3>{p.title}</h3><p>{p.text}</p></li>
      ))}
    </ul>
  </section>

  <section class="faq" id="faq" aria-labelledby="faq-title">
    <div class="faq__head">
      <h2 class="title faq__title" id="faq-title" data-split="lines">Questions, answered</h2>
      <p>Still curious? <a class="ulink" href={site.maker.x} rel="me noopener">DM @{site.maker.handle} on X</a>.</p>
    </div>
    <div class="faq__list">
      {faq.map((f, i) => (
        <details class="faq__item" data-reveal="up" data-delay={(i * 0.04).toFixed(2)} open={i === 0}>
          <summary><h3>{f.q}</h3><span class="faq__mark" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="beta" id="beta" aria-labelledby="beta-title">
    <div class="beta__main">
      <h2 class="title" id="beta-title" data-split="lines">Join the beta</h2>
      <p class="beta__lede">You are getting this early. Things will break, and what you find decides what gets built next.</p>
      <ol class="steps">
        <li data-reveal="place"><span class="steps__n" aria-hidden="true">1</span><span><strong>Download</strong> the disk image.</span></li>
        <li data-reveal="place" data-delay="0.08"><span class="steps__n" aria-hidden="true">2</span><span><strong>Drag</strong> Clash of Claudes onto Applications.</span></li>
        <li data-reveal="place" data-delay="0.16"><span class="steps__n" aria-hidden="true">3</span><span><strong>Launch</strong> it. It is signed and notarized, so it opens like any other app.</span></li>
      </ol>
      <DownloadButton label="Download the beta" />
    </div>
    <aside class="panel beta__panel" aria-labelledby="feedback-title" data-reveal="up">
      <h3 id="feedback-title">Send what you find</h3>
      <p>Bugs and ideas go straight from the app. You see the whole report before it is sent.</p>
      <ul class="menu-paths">
        <li><kbd>Help</kbd><span aria-label="then">›</span><kbd>Report a Bug…</kbd></li>
        <li><kbd>Help</kbd><span aria-label="then">›</span><kbd>Request a Feature…</kbd></li>
        <li><kbd>Settings</kbd><span aria-label="then">›</span><kbd>Beta feedback</kbd></li>
      </ul>
      <h3>It keeps itself current</h3>
      <p>New beta builds install themselves, so you are always testing the latest one.</p>
      <h3>You will need</h3>
      <ul class="needs">
        <li>An Apple Silicon or Intel Mac on macOS 13 or newer.</li>
        <li>At least one agent CLI installed and signed in.</li>
      </ul>
    </aside>
  </section>
</Base>
