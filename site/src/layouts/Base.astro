---
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';
import { builtVersion as buildVersion } from '../data/version';
import Curtain from '../components/Curtain.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const { title, description = site.description, image = '/og.png', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.tagline.toLowerCase()}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
// One graph for every page: who makes it, the site, and the app itself (answer engines read this).
const studioId = `${site.url}/#studio`;
const makerId = `${site.url}/#maker`;
const appId = `${site.url}/#app`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': studioId, name: site.studio.name, url: site.studio.url, founder: { '@id': makerId } },
    { '@type': 'Person', '@id': makerId, name: site.maker.name, alternateName: `@${site.maker.handle}`, url: site.maker.x, sameAs: [site.maker.x, `https://github.com/${site.maker.handle}`] },
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: site.url, name: site.name, description: site.description, publisher: { '@id': studioId }, inLanguage: 'en' },
    {
      '@type': 'SoftwareApplication', '@id': appId, name: site.name,
      applicationCategory: 'DeveloperApplication', applicationSubCategory: 'Coding agent manager',
      operatingSystem: 'macOS 13 or later (Apple Silicon or Intel)',
      description: site.description, url: site.url, downloadUrl: site.download, installUrl: site.download,
      ...(buildVersion ? { softwareVersion: buildVersion.replace(/^v/, '') } : {}),
      releaseNotes: site.releases,
      screenshot: new URL('/img/village-1600.webp', site.url).href,
      image: new URL('/og.png', site.url).href,
      author: { '@id': studioId }, publisher: { '@id': studioId }, creator: { '@id': makerId },
      featureList: [
        'Runs Claude Code, Codex, Antigravity CLI, OpenCode, Grok Build or any command in real terminals',
        'Shows every session as a builder: working, needs you, finished',
        'Allow or deny Claude Code and Antigravity permission prompts from the village',
        'Builder outfits by agent, ranks by model and hammers by effort level',
        'Elixir collectors for each agent’s token limits',
        'Claude Code subagents shown as minions',
        'Shells as forges and local web apps as boards',
        'Workspaces earn XP and their houses level up as tasks finish',
        'A Kanban per workspace with to-dos and live sessions',
        'Everything stays on your Mac; signed, notarized, auto-updating',
      ],
    },
  ],
};
---
<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#11301a" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Clash of Claudes: a painted village where each coding agent is a builder" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content={`@${site.maker.handle}`} />
    <meta name="twitter:creator" content={`@${site.maker.handle}`} />
    <meta name="author" content={`${site.maker.name}, ${site.studio.name}`} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    <link rel="preload" href="/fonts/lilita-one-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/host-grotesk-400_700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Curtain />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <!-- Vercel Web Analytics: cookieless page counts (see /privacy) -->
    <Analytics />
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
