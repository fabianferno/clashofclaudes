---
// The hero's background: the village's pieces floating around the centred headline, as the app
// draws them today (a house per workspace, the agent's tent, its builder in a state).
// Each piece is placed by its feet: x and y are percentages of the hero, s its width in a unit that
// follows the smaller of the screen's width and height, so nothing grows into the text on a short
// screen. Three depth layers move with scroll and the pointer (src/motion/hero.ts); each piece bobs on its
// own slow cycle. Phones show only the pieces that have an `m` placement, along the bottom.
import Builder from './Builder.astro';
import RisingTent from './RisingTent.astro';

type Spot = { x: number; y: number; s: number };
type Piece = { at?: Spot; m?: Spot; img?: string; ratio?: number; kind?: 'tent' | 'unit'; delay: number };
const img = (name: string) => `/img/${name}.webp`;
// Placements go in --d* and --m* so the stylesheet can pick one per screen (an inline --x would win).
const style = (p: Piece, i: number) =>
  (p.at ? `--dx:${p.at.x}%;--dy:${p.at.y}%;--ds:${p.at.s};` : '') +
  (p.m ? `--mx:${p.m.x}%;--my:${p.m.y}%;--ms:${p.m.s};` : '') +
  `--fd:${(6 + (i % 4) * 1.3).toFixed(1)}s;--fdl:${(-i * 0.9).toFixed(1)}s;z-index:${Math.round((p.at ?? p.m)!.y)}`;
const cls = (p: Piece, extra = '') => ['fl', extra, { 'fl--m': p.m, 'fl--phone': !p.at }];

const far: Piece[] = [
  { img: 'tree-pine', at: { x: 4, y: 36, s: 5 }, m: { x: 7, y: 19, s: 9 }, delay: 0.1 },
  { img: 'tree-oak', at: { x: 95, y: 30, s: 7 }, m: { x: 93, y: 19, s: 11 }, delay: 0.14 },
  { img: 'tree-fir', at: { x: 3.5, y: 80, s: 5 }, delay: 0.18 },
  { img: 'tree-pine', at: { x: 97, y: 78, s: 5 }, delay: 0.22 },
  { img: 'tree-elm', at: { x: 36, y: 106, s: 7 }, delay: 0.26 },
  { img: 'tree-fir', at: { x: 73, y: 103, s: 5 }, delay: 0.3 },
];
const mid: Piece[] = [
  { img: 'hall', m: { x: 50, y: 101, s: 36 }, delay: 0.2 },
  { img: 'house-orange', at: { x: 11, y: 47, s: 12 }, m: { x: 17, y: 97, s: 25 }, delay: 0.3 },
  { img: 'house-purple', at: { x: 89, y: 46, s: 12 }, m: { x: 84, y: 97, s: 25 }, delay: 0.34 },
  { img: 'tent-claude', ratio: 330 / 360, at: { x: 7, y: 67, s: 9 }, delay: 0.42 },
  { kind: 'tent', at: { x: 94, y: 67, s: 9 }, delay: 0.46 },
  { img: 'house-blue', at: { x: 14, y: 95, s: 11 }, delay: 0.38 },
  { img: 'house-teal', at: { x: 87, y: 96, s: 11 }, delay: 0.42 },
  { img: 'tent-opencode', ratio: 330 / 360, at: { x: 77, y: 100, s: 7 }, delay: 0.5 },
];
// The builders, one per agent, each in a state the app shows.
type Unit = Piece & { sheet: string; pose: 'idle' | 'hammer' | 'cheer' | 'walk'; over?: 'bubble' | 'ribbon'; plate?: [string, string] };
const units: Unit[] = [
  { sheet: 'master-claude', pose: 'cheer', over: 'ribbon', plate: ['done', 'Finished'], at: { x: 17, y: 69, s: 4.6 }, m: { x: 30, y: 99, s: 11 }, delay: 0.7 },
  { sheet: 'craftsman-codex', pose: 'hammer', plate: ['work', 'Working'], at: { x: 85, y: 70, s: 4.6 }, m: { x: 70, y: 99, s: 11 }, delay: 0.78 },
  { sheet: 'apprentice-antigravity', pose: 'idle', over: 'bubble', plate: ['needs', 'Needs you'], at: { x: 23, y: 97, s: 4.2 }, delay: 0.86 },
  { sheet: 'craftsman-opencode', pose: 'walk', at: { x: 69, y: 99, s: 4.2 }, delay: 0.94 },
];
---
<div class="field" aria-hidden="true" data-hero-field>
  <div class="field__clouds"><span></span><span></span></div>
  <div class="field__layer" data-depth="0.35">
    {far.map((p, i) => (
      <div class:list={cls(p)} style={style(p, i)} data-reveal="place" data-intro data-delay={p.delay}>
        <div class="fl__bob"><img src={img(p.img!)} alt="" width="200" height="260" loading="eager" decoding="async" /></div>
      </div>
    ))}
  </div>
  <div class="field__layer" data-depth="0.7">
    {mid.map((p, i) => (
      <div class:list={cls(p)} style={style(p, i + 6)} data-reveal="place" data-intro data-delay={p.delay}>
        <div class="fl__bob">
          {p.kind === 'tent'
            ? <RisingTent agent="codex" rise={0.4} building loading="eager" />
            : <img src={img(p.img!)} alt="" width="440" height={p.ratio ? 403 : 500} loading="eager" decoding="async" fetchpriority={p.img === 'hall' ? 'high' : undefined} />}
        </div>
      </div>
    ))}
  </div>
  <div class="field__layer" data-depth="1.2">
    {units.map((u, i) => (
      <div class:list={cls(u, 'fl--unit')} style={style(u, i + 14)} data-reveal="place" data-intro data-delay={u.delay}>
        <div class="fl__bob">
          {u.over && <img class={`fl__over fl__over--${u.over}`} src={`/img/${u.over === 'bubble' ? 'bubble-needs' : 'ribbon'}.webp`} alt="" width="140" height="140" />}
          <Builder sheet={u.sheet} pose={u.pose} />
          {u.plate && <span class={`plate plate--${u.plate[0]}`}>{u.plate[1]}</span>}
        </div>
      </div>
    ))}
  </div>
</div>
